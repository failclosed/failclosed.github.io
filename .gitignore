# Jekyll build output and caches — regenerated on every build, never commit
_site/
.jekyll-cache/
.jekyll-metadata

# Bundler local state — regenerated by `bundle install`
.bundle/
vendor/bundle/

# Generated at CI build time (see .github/workflows/ci.yml)
_config_ci.yml

# Gemfile.lock is intentionally not committed: this repo has no lockfile
# upstream, and a lockfile generated on one platform (e.g. Windows dev
# machine) records only that platform and can break CI running on
# ubuntu-latest unless `bundle lock --add-platform` is run for every
# platform that installs from it.
Gemfile.lock

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
